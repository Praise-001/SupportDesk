# Copy this file to .env and fill in what you need. Everything is optional.

# Your OpenRouter key (https://openrouter.ai/keys). Without it the assistant uses local FAQ
# and document matches with guided troubleshooting; account-specific tasks still go to staff.
OPENROUTER_API_KEY=

# Any model id from https://openrouter.ai/models. "openrouter/auto" lets OpenRouter choose.
OPENROUTER_MODEL=openrouter/auto

PORT=3000

# Where the SQLite database and generated secrets live (default: ./data)
# DATA_DIR=./data

# Secrets are generated on first run and saved in the data folder. Set these to override.
# JWT_SECRET=
# INBOUND_EMAIL_SECRET=

# Shown to OpenRouter as the referrer
# PUBLIC_URL=http://localhost:3000

# Pause before the assistant replies so it feels natural (milliseconds)
# BOT_DELAY_MS=600

# Set to off to start without the 32 made-up demo companies (they are added once, on the first start)
# DEMO_COMPANIES=off
